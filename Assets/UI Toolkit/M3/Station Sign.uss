.metro-line {
    flex-direction: row;
    font-size: 50px;
    align-self: center;
}

.metro-line .bg-accent {
    color: white;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    justify-content: center;
    align-items: center;
}

.line {
    width: 10px;
    height: 50px;
    scale: 1 1.01;
}

#Stops {
    width: 100%;
}

.stop Label {
    translate: 0 -50%;
}

.stop #Name {
    min-width: 350px;
    padding: 4px;
}

.stop.current #Name {
    background-color: #111;
}

.stop #Metros {
    min-width: 50px;
}
