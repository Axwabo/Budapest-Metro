.metro-line {
    flex-direction: row;
    font-size: 64px;
    align-self: center;
}

.metro-line .bg-accent {
    color: white;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    justify-content: center;
    align-items: center;
}

.line {
    width: 10px;
    height: 100px;
    scale: 1 1.003;
}

#Name {
    width: 300px;
    padding: 4px;
}

#name.current {
    background-color: #111;
}
