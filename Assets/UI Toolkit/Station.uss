Label {
    margin: 0;
    padding: 0;
}

.left {
    rotate: -135deg;
    translate: 0 -2px;
}

.board {
    width: 22%;
}

.bg-accent {
    background-color: var(--accent);
}

.border-accent {
    border-color: var(--accent);
}

.board.border-accent {
    border-top-width: 10px;
}

.stop {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    border-width: 4px;
}

.stop Label {
    position: absolute;
}
